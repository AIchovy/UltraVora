# Local development uses the same-origin Next.js proxy. Leave these unset.
# NEXT_PUBLIC_API_URL=https://api.example.com
# API_PROXY_TARGET=http://127.0.0.1:3001

# Canonical URL for your deployment (metadata, sitemap and social cards).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional voice audition clips. Default: /voices/<Name>.wav on this web server.
# NEXT_PUBLIC_VOICE_SAMPLE_BASE_URL=https://cdn.example.com/voices
