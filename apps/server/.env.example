# Copy to .env. Real credentials belong only in ignored local env files.
DATABASE_URL=postgres://localhost:5432/ultracreator
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register Google OAuth callback: http://localhost:3000/api/auth/callback/google

# Gemini is used for voice, image and music generation, even with another LLM.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# INTENT_LLM_PROVIDER=
# INTENT_LLM_MODEL=

# Email verification requires Resend and a sender on your verified domain.
RESEND_API_KEY=
EMAIL_FROM=UltraVora <noreply@example.com>
OTP_EXPIRES_MINUTES=15
# EMAIL_TEMPLATES_DIR=

# Optional cross-origin deployment. Unset for same-origin local development.
# WEB_ORIGIN=https://app.example.com
# COOKIE_DOMAIN=.example.com

# Optional GCS archiving. Unset means session media stays on local disk.
# GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# VOICE_SAMPLE_BUCKET=
RENDER_CONCURRENCY=1

# Real payments are disabled until all Creem values below are supplied.
# Payment stubs mint credits without payment. Enable ONLY for local development.
BILLING_STUBS=0
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_CREDITS=
# CREEM_PRODUCT_PRO_MONTHLY=
# CREEM_PRODUCT_PRO_YEARLY=
# CREEM_PRODUCT_MAX_MONTHLY=
# CREEM_PRODUCT_MAX_YEARLY=
# CREEM_PRODUCT_ULTRA_MONTHLY=
# CREEM_PRODUCT_ULTRA_YEARLY=
# CREEM_API_BASE=https://test-api.creem.io
